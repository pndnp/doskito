{
  "name": "doskito-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0 && stylelint 'src/**/*.{css,scss}'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run --exclude tests/e2e/**",
    "test:unit": "vitest run --exclude tests/e2e/**",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tanstack/react-query": "5.98.0",
    "axios": "1.16.0",
    "date-fns": "4.1.0",
    "lucide-react": "0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.15.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "vite": "7.3.1",
    "vitest": "4.1.0"
  }
}
