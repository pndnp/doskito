{
  "name": "doskito",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "fsevents": true,
    "prisma": true
  },
  "scripts": {
    "build": "npm run build --workspace=doskito-client && npm run build --workspace=doskito-server",
    "prepare": "husky",
    "format:check": "prettier --check .",
    "reinstall": "rm -rf node_modules client/node_modules server/node_modules && npm cache clean --force && npm i",
    "release": "standard-version"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "24.13.2",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "lint-staged": "16.3.3",
    "prettier": "3.8.3",
    "standard-version": "9.5.0",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "39.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.0"
  }
}
